rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(userId) { return signedIn() && userId == request.auth.uid; }
    function validText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'company', 'taxId', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.name, 120)
        && validText(request.resource.data.email, 254);
      allow read, update: if isOwner(userId);
      allow delete: if false;
    }

    match /users/{userId}/cart/{itemId} {
      allow read, write: if isOwner(userId);
    }

    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && validText(request.resource.data.name, 120)
        && validText(request.resource.data.email, 254)
        && validText(request.resource.data.subject, 160)
        && validText(request.resource.data.message, 4000)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /quoteRequests/{quoteId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'product', 'quantity', 'details', 'status', 'createdAt'])
        && validText(request.resource.data.name, 120)
        && validText(request.resource.data.email, 254)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'items', 'customer', 'estimatedTotals', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_quote'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.customer is map
        && request.resource.data.estimatedTotals is map
        && request.resource.data.createdAt is timestamp;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'orderHistory', 'adminNotes', 'priority',
          'estimatedDeliveryDate', 'deliveredAt', 'paymentStatus'
        ]);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if false;
    }

    match /customizationOptions/{optionId} {
      allow read: if true;
      allow write: if false;
    }

    match /pricingRules/{ruleId} {
      allow read: if true;
      allow write: if false;
    }

    match /promotions/{promotionId} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published';
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
